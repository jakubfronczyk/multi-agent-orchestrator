  "db_name": "SQLite",
  "query": "SELECT a.id, a.tool_call_id, a.custody, a.preview, a.status, a.note, a.expires_at, a.created_at,\n                  a.resolved_at, t.run_id AS \"run_id!\", r.root_run_id AS \"root_run_id!\", t.team_id AS \"team_id!\",\n                  t.tool AS \"tool!\", t.action\n           FROM approvals a\n           JOIN tool_calls t ON t.id = a.tool_call_id\n           JOIN runs r ON r.id = t.run_id\n           WHERE (?1 IS NULL OR a.status = ?1) AND (?2 IS NULL OR r.root_run_id = ?2)\n             AND (?3 IS NULL OR t.team_id = ?3)\n           ORDER BY a.created_at, a.id",
